# Database — Supabase: Settings → Database → Connection string → Direct connection
DB_URL=jdbc:postgresql://db.xxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=

# Security — generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Scheduling
SCHEDULER_TICK_MS=5000

# Alerting
CONSECUTIVE_FAILURES_THRESHOLD=3

# Email — Resend (preferred)
RESEND_API_KEY=
ALERT_EMAIL_FROM=CloudPulse <alerts@yourdomain.com>
ALERT_EMAIL_TO=

# Telegram — create bot via @BotFather, set token and username below
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5174
