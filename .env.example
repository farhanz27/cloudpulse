# Database
DATABASE_URL=postgresql+asyncpg://cloudpulse:123456e@localhost:5432/cloudpulse
POSTGRES_PASSWORD=123456

# Security — generate: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# App
APP_ENV=development
SCHEDULER_TICK_SECONDS=5

# Email — Resend (preferred)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
ALERT_EMAIL_FROM=CloudPulse <alerts@yourdomain.com>
ALERT_EMAIL_TO=

# Email — SMTP (fallback if RESEND_API_KEY is not set)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password

# Telegram — create bot via @BotFather, set token and username below
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
